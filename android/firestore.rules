rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function familyDoc(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function linkCodeDoc(code) {
      return /databases/$(database)/documents/linkCodes/$(code);
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isValidFamilyCreate() {
      return signedIn() &&
        request.resource.data.keys().hasOnly(["name", "createdAt", "createdBy"]) &&
        request.resource.data.name is string &&
        request.resource.data.createdAt is int &&
        request.resource.data.createdBy == request.auth.uid;
    }

    function isFamilyMember(familyId) {
      return signedIn() && exists(memberDoc(familyId));
    }

    function memberRole(familyId) {
      return get(memberDoc(familyId)).data.role;
    }

    function isPatient(familyId) {
      return isFamilyMember(familyId) && memberRole(familyId) == "patient";
    }

    function isCaregiver(familyId) {
      return isFamilyMember(familyId) && memberRole(familyId) == "caregiver";
    }

    function isValidPatientMemberCreate(familyId, userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(["role", "displayName", "phone", "linkedAt"]) &&
        request.resource.data.role == "patient" &&
        request.resource.data.displayName is string &&
        isNullableString(request.resource.data.phone) &&
        request.resource.data.linkedAt is int &&
        get(familyDoc(familyId)).data.createdBy == request.auth.uid;
    }

    function isValidCaregiverMemberCreate(familyId, userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(["role", "displayName", "phone", "linkedAt", "linkCode"]) &&
        request.resource.data.role == "caregiver" &&
        request.resource.data.displayName is string &&
        isNullableString(request.resource.data.phone) &&
        request.resource.data.linkedAt is int &&
        request.resource.data.linkCode is string &&
        exists(linkCodeDoc(request.resource.data.linkCode)) &&
        get(linkCodeDoc(request.resource.data.linkCode)).data.familyId == familyId &&
        get(linkCodeDoc(request.resource.data.linkCode)).data.expiresAt > request.time.toMillis() &&
        !existsAfter(linkCodeDoc(request.resource.data.linkCode));
    }

    function isValidMemberUpdate(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "phone",
          "fcmToken"
        ]) &&
        isNullableString(request.resource.data.displayName) &&
        isNullableString(request.resource.data.phone) &&
        isNullableString(request.resource.data.fcmToken);
    }

    function isValidPatientDocument() {
      return request.resource.data.keys().hasOnly([
        "name",
        "age",
        "mainCaregiverId",
        "updatedAt"
      ]) &&
        request.resource.data.name is string &&
        (request.resource.data.age == null || request.resource.data.age is int) &&
        isNullableString(request.resource.data.mainCaregiverId) &&
        request.resource.data.updatedAt is int;
    }

    function isValidMedicationDocument() {
      return request.resource.data.keys().hasOnly([
        "name",
        "dose",
        "time24",
        "instructions",
        "color",
        "shape",
        "active",
        "scheduleType",
        "startDate",
        "endDate",
        "daysOfWeek",
        "specificDates",
        "createdAt",
        "updatedAt",
        "updatedBy",
        "imagePath"
      ]) &&
        request.resource.data.name is string &&
        request.resource.data.dose is string &&
        request.resource.data.time24 is string &&
        isNullableString(request.resource.data.instructions) &&
        isNullableString(request.resource.data.color) &&
        isNullableString(request.resource.data.shape) &&
        request.resource.data.active is bool &&
        request.resource.data.scheduleType in [
          "ALWAYS",
          "DATE_RANGE",
          "WEEKLY_DAYS",
          "SPECIFIC_DATES"
        ] &&
        request.resource.data.startDate is timestamp &&
        (
          !("endDate" in request.resource.data) ||
          request.resource.data.endDate == null ||
          request.resource.data.endDate is timestamp
        ) &&
        request.resource.data.daysOfWeek is list &&
        request.resource.data.specificDates is list &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        isNullableString(request.resource.data.updatedBy) &&
        (
          !("imagePath" in request.resource.data) ||
          request.resource.data.imagePath == null ||
          request.resource.data.imagePath is string
        );
    }

    function isValidPressureReading() {
      return request.resource.data.keys().hasOnly([
        "systolic",
        "diastolic",
        "pulse",
        "note",
        "measuredAt",
        "createdBy",
        "syncedAt",
        "status"
      ]) &&
        request.resource.data.systolic is int &&
        request.resource.data.diastolic is int &&
        (request.resource.data.pulse == null || request.resource.data.pulse is int) &&
        isNullableString(request.resource.data.note) &&
        request.resource.data.measuredAt is int &&
        isNullableString(request.resource.data.createdBy) &&
        request.resource.data.syncedAt is int &&
        request.resource.data.status is string;
    }

    function isValidMedicationLog() {
      return request.resource.data.keys().hasOnly([
        "medicationId",
        "scheduledAt",
        "takenAt",
        "status",
        "skipReason",
        "createdBy",
        "syncedAt"
      ]) &&
        request.resource.data.medicationId is string &&
        request.resource.data.scheduledAt is int &&
        (request.resource.data.takenAt == null || request.resource.data.takenAt is int) &&
        request.resource.data.status is string &&
        isNullableString(request.resource.data.skipReason) &&
        isNullableString(request.resource.data.createdBy) &&
        request.resource.data.syncedAt is int;
    }

    function isValidHealthSettings() {
      return request.resource.data.keys().hasOnly([
        "systolicMin",
        "systolicMax",
        "diastolicMin",
        "diastolicMax",
        "pulseMin",
        "pulseMax",
        "doctorRecommendation",
        "updatedAt"
      ]) &&
        request.resource.data.systolicMin is int &&
        request.resource.data.systolicMax is int &&
        request.resource.data.diastolicMin is int &&
        request.resource.data.diastolicMax is int &&
        request.resource.data.pulseMin is int &&
        request.resource.data.pulseMax is int &&
        isNullableString(request.resource.data.doctorRecommendation) &&
        request.resource.data.updatedAt is int;
    }

    function isValidFamilyContact() {
      return request.resource.data.keys().hasOnly([
        "fullName",
        "phone",
        "relationship",
        "updatedAt"
      ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.phone is string &&
        isNullableString(request.resource.data.relationship) &&
        request.resource.data.updatedAt is int;
    }

    function isValidReminderPreferences() {
      return request.resource.data.keys().hasOnly([
        "remindersEnabled",
        "repeatIntervalMinutes",
        "maxRepeatCount",
        "soundEnabled",
        "vibrationEnabled",
        "notifyCaregiverOnMissed",
        "voiceAssistantEnabled",
        "voiceReminderEnabled",
        "voiceRepeatCount",
        "easyModeEnabled",
        "voiceGuidanceEnabled",
        "updatedAt"
      ]) &&
        request.resource.data.remindersEnabled is bool &&
        request.resource.data.repeatIntervalMinutes is int &&
        request.resource.data.maxRepeatCount is int &&
        request.resource.data.soundEnabled is bool &&
        request.resource.data.vibrationEnabled is bool &&
        request.resource.data.notifyCaregiverOnMissed is bool &&
        request.resource.data.voiceAssistantEnabled is bool &&
        request.resource.data.voiceReminderEnabled is bool &&
        request.resource.data.voiceRepeatCount is int &&
        request.resource.data.easyModeEnabled is bool &&
        request.resource.data.voiceGuidanceEnabled is bool &&
        request.resource.data.updatedAt is int;
    }

    function isValidAlert() {
      return request.resource.data.keys().hasOnly([
        "type",
        "message",
        "createdAt",
        "seen",
        "severity",
        "scheduledAt",
        "medicationIds"
      ]) &&
        request.resource.data.type is string &&
        request.resource.data.message is string &&
        request.resource.data.createdAt is int &&
        request.resource.data.seen is bool &&
        (
          !("severity" in request.resource.data) ||
          request.resource.data.severity is string
        ) &&
        (
          !("scheduledAt" in request.resource.data) ||
          request.resource.data.scheduledAt is int
        ) &&
        (
          !("medicationIds" in request.resource.data) ||
          request.resource.data.medicationIds is list
        );
    }

    function isValidLinkCodeCreate() {
      return signedIn() &&
        request.resource.data.keys().hasOnly(["familyId", "patientId", "expiresAt", "createdBy"]) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.familyId is string &&
        request.resource.data.patientId is string &&
        request.resource.data.expiresAt is int &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        isPatient(request.resource.data.familyId);
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isValidFamilyCreate();
      allow update: if isFamilyMember(familyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]) &&
        request.resource.data.name is string;
      allow delete: if false;

      match /members/{userId} {
        allow read: if isFamilyMember(familyId);
        allow create: if
          isValidPatientMemberCreate(familyId, userId) ||
          isValidCaregiverMemberCreate(familyId, userId);
        allow update: if isValidMemberUpdate(userId);
        allow delete: if false;
      }

      match /patients/{patientId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if (isPatient(familyId) || isCaregiver(familyId)) &&
          isValidPatientDocument();
        allow delete: if false;

        match /medications/{medicationId} {
          allow read: if isFamilyMember(familyId);
          allow create, update: if (isCaregiver(familyId) || isPatient(familyId)) &&
            isValidMedicationDocument();
          allow delete: if false;
        }

        match /pressureReadings/{readingId} {
          allow read: if isFamilyMember(familyId);
          allow create: if (isPatient(familyId) || isCaregiver(familyId)) &&
            isValidPressureReading();
          allow update: if false;
          allow delete: if isPatient(familyId) || isCaregiver(familyId);
        }

        match /medicationLogs/{logId} {
          allow read: if isFamilyMember(familyId);
          allow create: if (isPatient(familyId) || isCaregiver(familyId)) &&
            isValidMedicationLog();
          allow update: if false;
          allow delete: if false;
        }

        match /healthSettings/{docId} {
          allow read: if isFamilyMember(familyId);
          allow create, update: if (isCaregiver(familyId) || isPatient(familyId)) &&
            isValidHealthSettings();
          allow delete: if false;
        }

        match /alerts/{alertId} {
          allow read: if isFamilyMember(familyId);
          allow create: if (isPatient(familyId) || isCaregiver(familyId)) &&
            isValidAlert();
          allow update: if isFamilyMember(familyId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seen"]) &&
            request.resource.data.seen is bool;
          allow delete: if false;
        }

        match /contact/{docId} {
          allow read: if isFamilyMember(familyId);
          allow create, update: if (isCaregiver(familyId) || isPatient(familyId)) &&
            isValidFamilyContact();
          allow delete: if false;
        }

        match /preferences/{docId} {
          allow read: if isFamilyMember(familyId);
          allow create, update: if (isCaregiver(familyId) || isPatient(familyId)) &&
            docId == "reminders" &&
            isValidReminderPreferences();
          allow delete: if false;
        }
      }
    }

    match /linkCodes/{code} {
      allow create: if isValidLinkCodeCreate();
      allow get: if signedIn() && resource.data.expiresAt > request.time.toMillis();
      allow list: if false;
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        (
          !exists(memberDoc(resource.data.familyId)) &&
          existsAfter(memberDoc(resource.data.familyId)) &&
          getAfter(memberDoc(resource.data.familyId)).data.role == "caregiver" &&
          getAfter(memberDoc(resource.data.familyId)).data.linkCode == code
        )
      );
    }
  }
}
